    "bench-warm-build": "node ./bench-warm-build.mjs"
  },
  "devDependencies": {
    "fuzzponent": "workspace:*",
    "pretty-ms": "^7.0.1",
    "rimraf": "^3.0.2",
    "next": "workspace:*"
  }
}
