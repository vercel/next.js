{
  "compilerOptions": {
    "target": "es2019",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": false,
    "useDefineForClassFields": true
  },
  "exclude": ["templates", "dist"],
  "files": ["index.ts"]
}
