# Allow node_modules in test fixtures
!node_modules/
# Allow dist/ under fixture node_modules (the bundled docs fixture ships a
# fake next/dist/docs/ tree so `hasBundledDocs` has something to find). Path
# is fully anchored so the root `.gitignore`'s unanchored `dist` rule loses.
!/next-bundled-docs/node_modules/next/dist/
!/next-bundled-docs/node_modules/next/dist/**
