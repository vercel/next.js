{
  "name": "@turbopack/nft",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run build-native && pnpm run build-js",
    "build-js": "tsc -p tsconfig.json",
    "build-native": "napi build --platform -p turbopack-nft-napi --manifest-path ../../Cargo.toml --no-js -o native",
    "build-native-release": "napi build --platform -p turbopack-nft-napi --manifest-path ../../Cargo.toml --release --no-js -o native",
    "test:unit": "pnpm run build && node --test test/unit.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "napi": {
    "binaryName": "turbopack-nft",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "3.4.1",
    "@types/node": "20.17.7",
    "typescript": "6.0.2"
  }
}
