    "typescript": "tsc --noEmit",
    "pack-for-isolated-tests": "pnpm pack --out ./packed.tgz"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/semver": "7.3.1",
    "@vercel/ncc": "0.38.4",
    "semver": "7.3.2",
    "typescript": "6.0.2",
    "@types/cross-spawn": "6.0.0",
    "@types/debug": "4.1.5",
    "@vercel/detect-agent": "1.2.3",
    "cli-select": "1.1.2",
    "commander": "12.1.0",
    "cross-spawn": "7.0.3",
    "debug": "4.1.1",
    "ora": "4.0.4",
    "tsx": "4.19.2",
    "conf": "5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "bin": {
    "next-upgrade": "./dist/bin/next-upgrade.js"
  }
