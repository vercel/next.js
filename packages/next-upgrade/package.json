{
  "name": "@next/upgrade",
  "version": "16.5.0-canary.3",
  "description": "Upgrade Next.js apps from the terminal or with an agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/next.js",
    "directory": "packages/next-upgrade"
  },
  "author": "Next.js Team <support@vercel.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
