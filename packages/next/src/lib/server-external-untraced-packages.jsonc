[
  // Dev-only packages that should be external but NOT traced for standalone output.
  // These packages are used during build but are not needed at runtime.
  // Including them in the standalone output would unnecessarily increase bundle size.

  // TypeScript and related tools
  "typescript",
  "ts-node",
  "ts-morph",

  // Linters and formatters
  "eslint",
  "prettier",

  // Build tools
  "webpack",
  "postcss",
  "autoprefixer",

  // Testing frameworks
  "jest",
  "cypress",
  "playwright",
  "playwright-core",
  "puppeteer",
  "puppeteer-core",

  // Other dev tools that should not be traced
  "jsdom"
]

