{
  "name": "@vercel/turbopack-trace-server-wasm",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build-trace-wasm": "napi build --target wasm32-wasip1-threads --release --manifest-path ../Cargo.toml --output-dir ."
  },
  "napi": {
    "binaryName": "turbopack-trace-server-wasm",
    "targets": [
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "initialMemory": 8192,
      "maximumMemory": 65536
    }
  },
  "dependencies": {
    "@emnapi/runtime": "2.0.0-beta.3",
    "@napi-rs/wasm-runtime": "1.2.7"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.3",
    "@napi-rs/cli": "3.10.12",
    "emnapi": "2.0.0-beta.3"
  }
}
