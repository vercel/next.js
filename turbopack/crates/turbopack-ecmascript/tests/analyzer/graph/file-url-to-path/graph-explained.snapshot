cjsFilename (const after eval) = FreeVar(__filename)

cjsWorkerPath (const after eval) = module<node:path, {}>["join"](
    module<node:path, {}>["dirname"](FreeVar(__filename)),
    "worker.cjs"
)

filename (const after eval) = module<node:url, {}>["fileURLToPath"](import.meta*0*["url"])
