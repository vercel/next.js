nonConstant (const after eval) = module<node:url, {}>["fileURLToPath"](FreeVar(globalThis)["foo"])

workerPath (const after eval) = module<node:path, {}>["join"](
    module<node:path, {}>["dirname"](
        module<node:url, {}>["fileURLToPath"](import.meta*0*["url"])
