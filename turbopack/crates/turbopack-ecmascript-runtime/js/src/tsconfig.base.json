{
  "compilerOptions": {
    // type checking
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // environment
    "target": "ESNext",

    // modules
    "module": "CommonJS",
    // The runtime is written as global scripts that share declarations through
    // `/// <reference>`, so files must not be implicitly treated as modules.
    "moduleDetection": "auto",
    "types": [], // disable implicit types.

    // emit
    "noEmit": true,
    "stripInternal": true
  }
}
