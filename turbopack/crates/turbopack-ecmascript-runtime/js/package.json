{
  "name": "@vercel/turbopack-ecmascript-runtime",
  "version": "0.0.0",
  "description": "Turbopack EcmaScript runtime code and utilities",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "typescript": "pnpm check",
    "check": "run-p check:*",
    "check:nodejs-build": "tsc -p src/nodejs/tsconfig.build.json",
    "check:nodejs-dev": "tsc -p src/nodejs/tsconfig.dev.json",
    "check:browser-dev-client": "tsc -p src/browser/dev/hmr-client",
    "check:browser-runtime-base-build": "tsc -p src/browser/runtime/base/tsconfig.build.json",
    "check:browser-runtime-base-dev": "tsc -p src/browser/runtime/base/tsconfig.dev.json",
    "check:browser-runtime-dom": "tsc -p src/browser/runtime/dom",
    "check:browser-runtime-self-contained": "tsc -p src/browser/runtime/self-contained"
  },
  "exports": {
    ".": "./src/main.js",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@types/node": "^18.11.11"
  },
  "devDependencies": {
    "@next/react-refresh-utils": "workspace:*",
    "npm-run-all": "^4.1.5"
  }
}
