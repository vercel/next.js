+common.parseUrl = function(urlValue) {
+  var parsed = parseUrl(urlValue);
+  var bracketedHostname = parsed.hostname;
+  return Object.assign(parsed, {
+    host: bracketedHostname
+      ? bracketedHostname + (parsed.port ? ':' + parsed.port : '')
+      : bracketedHostname,
+    hostname:
+      bracketedHostname && bracketedHostname.startsWith('[')
+        ? bracketedHostname.slice(1, -1)
+        : bracketedHostname,
+    path: parsed.pathname + parsed.search,
+  });
+};
