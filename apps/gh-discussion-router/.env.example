# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens/new
# Required scopes: repo or public_repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# GitHub Repository (required)
# Format: owner/repo
GITHUB_REPO=vercel/next.js

# Similarity Threshold (optional)
# Range: 0.0 - 1.0, Default: 0.4
SIMILARITY_THRESHOLD=0.4

# Max Discussions to Fetch (optional)
# Default: 100
# Increase to 2000 to fetch most discussions (for repos like next.js with 1200+)
# Higher values = more API calls but better search coverage
MAX_DISCUSSIONS_TO_FETCH=100
