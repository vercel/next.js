{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest"]
  },
  "include": [
    "lib",
    "types",
    "evals/*/EVAL.ts",
    "evals/*/__eval__/measure-browser-js.ts",
    "evals/*/eval-setup.mjs",
    "experiments",
    "next-upgrade/experiments",
    "next-upgrade/lib",
    "next-upgrade/shared",
    "next-upgrade/evals/*/EVAL.ts",
    "next-upgrade/security/setup.ts"
  ]
}
