  "sources": {
    "a": "import { test, expect, beforeEach, afterEach, onTestFinished } from 'vitest'\nimport { watch, existsSync, writeFileSync, appendFileSync, mkdirSync } from 'node:fs'\nimport { choose } from './subject.mjs'\nconst label = \"a\"\nmkdirSync('parallel-cancel', { recursive: true })\nconst record = (event, data = {}) => appendFileSync('parallel-cancel/trace.jsonl', JSON.stringify({event, label, pid: process.pid, ...data})+'\\n')\nprocess.on('exit', code => record('worker-exit', {code}))\nbeforeEach(context => record('beforeEach', {name: context.task.name}))\nafterEach(context => record('afterEach', {name: context.task.name, state: context.task.result?.state, aborted: context.signal.aborted, reason: context.signal.reason?.message}))\ntest(label+' active', async () => {\n  onTestFinished(context => record('onTestFinished', {state: context.task.result?.state}))\n  choose(true)\n  record('body-start')\n  await new Promise(resolve => {\n    if (existsSync('.next/cancel-controls/'+label+'-release')) { resolve(); return }\n    const watcher = watch('.next/cancel-controls', () => {\n      if (existsSync('.next/cancel-controls/'+label+'-release')) { watcher.close(); resolve() }\n    })\n    writeFileSync('.next/cancel-controls/'+label+'-started', 'ready')\n  })\n  record('body-finished')\n}, 10000)\ntest(label+' queued', () => record('queued-body'))\n",
    "b": "import { test, expect, beforeEach, afterEach, onTestFinished } from 'vitest'\nimport { watch, existsSync, writeFileSync, appendFileSync, mkdirSync } from 'node:fs'\nimport { choose } from './subject.mjs'\nconst label = \"b\"\nmkdirSync('parallel-cancel', { recursive: true })\nconst record = (event, data = {}) => appendFileSync('parallel-cancel/trace.jsonl', JSON.stringify({event, label, pid: process.pid, ...data})+'\\n')\nprocess.on('exit', code => record('worker-exit', {code}))\nbeforeEach(context => record('beforeEach', {name: context.task.name}))\nafterEach(context => record('afterEach', {name: context.task.name, state: context.task.result?.state, aborted: context.signal.aborted, reason: context.signal.reason?.message}))\ntest(label+' active', async () => {\n  onTestFinished(context => record('onTestFinished', {state: context.task.result?.state}))\n  choose(false)\n  record('body-start')\n  await new Promise(resolve => {\n    if (existsSync('.next/cancel-controls/'+label+'-release')) { resolve(); return }\n    const watcher = watch('.next/cancel-controls', () => {\n      if (existsSync('.next/cancel-controls/'+label+'-release')) { watcher.close(); resolve() }\n    })\n    writeFileSync('.next/cancel-controls/'+label+'-started', 'ready')\n  })\n  record('body-finished')\n}, 10000)\ntest(label+' queued', () => record('queued-body'))\n"
  },
