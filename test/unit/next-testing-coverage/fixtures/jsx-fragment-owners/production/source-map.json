    "export function label(value) { return value + '!' }\n",
    "import React from 'react'\nimport { label } from './helper.js'\ntype Props = { active: boolean; name: string }\nexport function Fragment({ active, name }: Props) {\n  return <>{active && <span>{label(name)}</span>}<em>{label('tail')}</em></>\n}\nexport const Arrow = ({ name }: Props): React.ReactElement => (\n  <>\n    <p data-name={name}>{label(name)}</p>\n  </>\n)\n"
