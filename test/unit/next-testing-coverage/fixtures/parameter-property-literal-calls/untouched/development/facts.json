    "sourcesContent": [
      "throw new Error(\"coverage-only source must never evaluate\")\nfunction initial(value: number): number { return value }\nexport class Counter {\n  constructor(public value: number = initial(3)) {}\n  add(delta: number): number {\n    this.value += delta\n    return this.value\n  }\n}\nexport function exercise(): number[] {\n  const counter = new Counter()\n  return [counter.value, counter.add(2)]\n}\n"
