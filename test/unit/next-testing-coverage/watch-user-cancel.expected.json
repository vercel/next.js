  "sources": {
    "initial": "import { test, expect, beforeEach, afterEach, onTestFinished } from 'vitest'\nimport { watch, existsSync, writeFileSync, appendFileSync, mkdirSync } from 'node:fs'\nimport { threadId } from 'node:worker_threads'\nimport { choose } from './subject.mjs'\nmkdirSync('cancel-settlement', { recursive: true })\nconst record = (event, data = {}) => appendFileSync('cancel-settlement/trace.jsonl', JSON.stringify({event, pid: process.pid, threadId, ...data})+'\\n')\nprocess.on('exit', code => record('worker-exit', {code}))\nbeforeEach(context => record('beforeEach', {name: context.task.name}))\nafterEach(context => record('afterEach', {name: context.task.name, state: context.task.result?.state}))\ntest('controlled cancellation body', async () => {\n  onTestFinished(context => record('onTestFinished', {state: context.task.result?.state}))\n  expect(choose(true)).toBe(1)\n  record('body-start')\n  await new Promise(resolve => {\n    const watcher = watch('.next/cancel-controls', () => {\n      if (existsSync('.next/cancel-controls/gate-release')) { watcher.close(); resolve() }\n    })\n    writeFileSync('.next/cancel-controls/gate-started', 'ready')\n  })\n  record('body-finished')\n}, 10000)\ntest('queued after controlled cancellation', () => {\n  record('queued-body')\n  expect(true).toBe(true)\n})\n",
    "prior": "import { test, expect, beforeEach, afterEach, onTestFinished } from 'vitest'\nimport { watch, existsSync, writeFileSync, appendFileSync, mkdirSync } from 'node:fs'\nimport { threadId } from 'node:worker_threads'\nimport { choose } from './subject.mjs'\nmkdirSync('cancel-settlement', { recursive: true })\nconst record = (event, data = {}) => appendFileSync('cancel-settlement/trace.jsonl', JSON.stringify({event, pid: process.pid, threadId, ...data})+'\\n')\nprocess.on('exit', code => record('worker-exit', {code}))\nbeforeEach(context => record('beforeEach', {name: context.task.name}))\nafterEach(context => record('afterEach', {name: context.task.name, state: context.task.result?.state}))\ntest('controlled cancellation body', async () => {\n  onTestFinished(context => record('onTestFinished', {state: context.task.result?.state}))\n  expect(choose(true)).toBe(1)\n  record('body-start')\n  if (!existsSync('.next/cancel-controls/gate-mode')) return\n  await new Promise(resolve => {\n    const watcher = watch('.next/cancel-controls', () => {\n      if (existsSync('.next/cancel-controls/gate-release')) { watcher.close(); resolve() }\n    })\n    writeFileSync('.next/cancel-controls/gate-started', 'ready')\n  })\n  record('body-finished')\n}, 10000)\ntest('queued after controlled cancellation', () => {\n  record('queued-body')\n  expect(true).toBe(true)\n})\n",
    "priorSecond": "import {test} from 'vitest'\nimport {appendFileSync,mkdirSync} from 'node:fs'\nimport {second} from './second-subject.mjs'\nconst record=event=>{mkdirSync('cancel-settlement',{recursive:true});appendFileSync('cancel-settlement/trace.jsonl',JSON.stringify({event,pid:process.pid})+'\\n')}\nrecord('second-module-evaluated')\ntest('queued second file',()=>{record('second-body');second()})\n"
  },
