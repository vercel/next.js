  "reporter": "import{appendFileSync,existsSync,writeFileSync}from'node:fs'\nimport{basename,join}from'node:path'\nconst queued=new Map(),collected=new Map()\nconst record=value=>appendFileSync(process.env.QUEUED_TRACE,JSON.stringify({actor:'reporter',...value})+'\\n')\nconst info=m=>({file:basename(m.moduleId),relativeModuleId:m.relativeModuleId,state:m.state(),children:m.children.size,childNames:[...m.children].map(c=>({type:c.type,name:c.name})),tests:[...m.children.allTests()].map(t=>({name:t.name,state:t.result().state})),errors:m.errors().map(e=>e.message),project:m.project.name,type:m.type,id:m.id})\nexport default class{\n constructor(){writeFileSync(process.env.QUEUED_RUNTIME,JSON.stringify({execPath:process.execPath,versions:process.versions}))}\n onTestModuleQueued(m){queued.set(basename(m.moduleId),m);record({event:'queued',...info(m)})}\n onTestModuleCollected(m){const file=basename(m.moduleId);collected.set(file,m);record({event:'collected',sameQueued:m===queued.get(file),...info(m)})}\n async onTestModuleStart(m){const file=basename(m.moduleId);record({event:'start',sameCollected:m===collected.get(file),sameQueued:m===queued.get(file),...info(m)});writeFileSync(join(process.env.QUEUED_MARKERS,file),'start');while(!existsSync(join(process.env.QUEUED_RELEASE,file)))await new Promise(resolve=>setTimeout(resolve,10));record({event:'start-return',...info(m)})}\n onTestModuleEnd(m){const c=collected.get(basename(m.moduleId));record({event:'end',sameCollected:m===c,sameQueued:m===queued.get(basename(m.moduleId)),...info(m)})}\n onTestRunEnd(modules,errors,reason){record({event:'run-end',reason,errors:errors.map(e=>e.message),modules:modules.map(m=>({sameCollected:m===collected.get(basename(m.moduleId)),sameQueued:m===queued.get(basename(m.moduleId)),...info(m)}))})}\n}\n",
