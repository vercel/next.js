    "profile": "skip-todo-body",
    "source": "import{test,describe,beforeAll,afterAll}from'vitest'\nimport{appendFileSync}from'node:fs'\nconst record=event=>appendFileSync(process.env.MODE_TRACE,JSON.stringify({actor:'author',event})+'\\n')\nrecord('module-enter');beforeAll(()=>record('before-all'));afterAll(()=>record('after-all'));\ndescribe.skip('outer',()=>{describe.todo('explicit todo',()=>{describe('implicit body',()=>{beforeAll(()=>record('BAD_BEFORE'));afterAll(()=>record('BAD_AFTER'));test('body',()=>record('BAD_BODY'))})})})\n",
    "reporter": "import{appendFileSync}from'node:fs'\nimport{basename}from'node:path'\nconst roots=new Map();const write=value=>appendFileSync(process.env.MODE_TRACE,JSON.stringify({actor:'reporter',...value})+'\\n')\nconst tree=t=>({type:t.type,name:t.type==='module'?basename(t.moduleId):t.name,state:t.type==='test'?t.result().state:t.state(),...(t.type==='module'?{}:{mode:t.options.mode}),errors:t.type==='test'?[]:t.errors().map(e=>e.message),...(t.type==='test'?{}:{children:[...t.children].map(tree)})})\nexport default class{\n onTestModuleQueued(m){write({event:'queued',tree:tree(m)})}\n onTestModuleCollected(m){roots.set(m.id,m);write({event:'collected',tree:tree(m)})}\n onTestCaseResult(t){write({event:'case-result',tree:tree(t)})}\n onTestModuleEnd(m){write({event:'end',sameCollected:m===roots.get(m.id),tree:tree(m)})}\n onTestRunEnd(modules,errors,reason){write({event:'run-end',reason,errors:errors.map(e=>e.message),modules:modules.map(m=>({sameCollected:m===roots.get(m.id),tree:tree(m)}))})}\n}",
    "config": {
      "test": {
