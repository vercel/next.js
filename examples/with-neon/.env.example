# Neon — create a project at https://neon.tech and copy the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Better Auth — use a long random string (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# App URL — use http://localhost:3000 in development; set to your deployment URL on Vercel.
BETTER_AUTH_URL="http://localhost:3000"
