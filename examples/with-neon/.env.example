# Update these with your Neon project details from https://console.neon.tech
# Connection string: Dashboard > Connect
DATABASE_URL=your-connection-string
# Auth URL: Auth > Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# Secret used to sign the session cookie (32+ characters): openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long
