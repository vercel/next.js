// use prisma-8

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int                @id @default(autoincrement())
  createdAt DateTime           @default(now())
  updatedAt temporal.UpdatedAt
  title     String
  content   String?
  published Boolean            @default(false)
  authorId  Int
  author    User               @relation(fields: [authorId], references: [id])
}
