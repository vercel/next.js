        usuario = os.getlogin() if hasattr(os, 'getlogin') else "USUARIO_DIVINO"
        ruta_absoluta = os.path.abspath(repositorio_path)
        
        # Crear cadena para hash
        cadena_sagrada = f"{sal_divina}::{timestamp}::{usuario}::{ruta_absoluta}"
        
        # Aplicar múltiples algoritmos de hash (como múltiples sellos)
        hashes = []
        
        # SHA-256 (Primer sello)
        hash1 = hashlib.sha256(cadena_sagrada.encode()).hexdigest()
        hashes.append(f"SHA256:{hash1}")
        
        # SHA-512 (Segundo sello)
        hash2 = hashlib.sha512(cadena_sagrada.encode()).hexdigest()
        hashes.append(f"SHA512:{hash2}")
        
        # SHA3-256 (Tercer sello)
        hash3 = hashlib.sha3_256(cadena_sagrada.encode()).hexdigest()
        hashes.append(f"SHA3_256:{hash3}")
        
        # Blake2b (Cuarto sello)
        hash4 = hashlib.blake2b(cadena_sagrada.encode()).hexdigest()
        hashes.append(f"BLAKE2B:{hash4}")
        
        return "::".join(hashes)
    
